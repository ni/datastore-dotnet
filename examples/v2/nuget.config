<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="niartifacts-nuget-packages" value="https://pull.artifacts.ni.com/artifactory/api/nuget/v3/rnd-nuget-pre" />
  </packageSources>

  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="niartifacts-nuget-packages">
      <package pattern="NI.DataStore.V2" />
      <package pattern="NI.Measurements.Data.V2.Api" />
      <package pattern="NI.Measurements.Metadata.V1.Api" />
    </packageSource>
  </packageSourceMapping>

  <config>
    <add key="httpTimeout" value="180" />
  </config>
</configuration>
